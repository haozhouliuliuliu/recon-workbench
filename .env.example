# ============================================================
# 复制为 .env 后填写本机配置。.env 已被 .gitignore 忽略，绝不入库。
# 本模板中不包含任何真实密钥；下方全部为占位符。
# 注意：程序只读取进程环境变量，不会自动加载本文件。
#       可手动 `set -a; source .env` / `$env:LLM_API_KEY="..."`，或由部署平台注入。
# ============================================================

# --- LLM 审核模块（阶段 2 使用）---
# 兼容 OpenAI Chat Completions 协议的任意服务商均可。
LLM_API_BASE=https://api.example.invalid/v1
LLM_API_KEY=sk-replace-me-with-your-own-key
LLM_MODEL=example-model-name
LLM_TIMEOUT_SECONDS=30
# 失败后的重试次数（总尝试次数 = 1 + LLM_MAX_RETRIES）
LLM_MAX_RETRIES=2
# 低于该置信度的审核结论一律转人工复核，绝不自动通过
LLM_CONFIDENCE_THRESHOLD=0.85
LLM_TEMPERATURE=0
# 是否要求服务商返回 JSON 对象（response_format）；不支持的服务商可设为 0
LLM_JSON_MODE=1

# --- 应用配置（阶段 3/4 使用）---
APP_ENV=local
APP_DATABASE_URL=sqlite:///./data/recon.db
APP_STORAGE_DIR=./data/storage
APP_LOG_LEVEL=INFO

# --- 演示保护 ---
# 本项目为公开演示，禁止接入真实银行/ERP 或执行真实资金操作
DEMO_MODE=true
