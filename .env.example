# ============================================================
# 复制为 .env 后填写本机配置。.env 已被 .gitignore 忽略，绝不入库。
# 本模板不包含任何真实密钥；程序只读进程环境变量，不自动加载本文件。
#   bash:       set -a; source .env; set +a
#   PowerShell: $env:RECON_DB_PATH="data/recon.db" ...
#   Docker:     docker compose --env-file .env up
# ============================================================

# ---------- 运行参数（阶段 3/4/5）----------
RECON_DB_PATH=data/recon.db
RECON_STORAGE_DIR=data/jobs
RECON_UPLOAD_DIR=data/uploads
# 单个上传文件上限（字节），默认 20MB
RECON_MAX_UPLOAD_BYTES=20971520

# ---------- 复核（阶段 2/4）----------
# stub=本地假响应（无需密钥，演示用）；openai=真实调用
RECON_REVIEW_PROVIDER=stub
RECON_REVIEW_ENABLED=true
RECON_REVIEW_THRESHOLD=0.85
RECON_REVIEW_LIMIT=20

# ---------- 日志 ----------
RECON_LOG_LEVEL=INFO
# 1=每行一个 JSON，便于容器采集
RECON_LOG_JSON=0

# ---------- HTTP 服务 ----------
RECON_HOST=0.0.0.0
RECON_PORT=8000

# ---------- 引擎策略（可选 TOML）----------
# 例：[policy] 段，可设置 amount_tolerance / invoice_pattern 等
# RECON_POLICY_FILE=config/recon.toml

# ---------- LLM（仅 RECON_REVIEW_PROVIDER=openai 时需要）----------
# 兼容 OpenAI Chat Completions 协议的服务商均可。
LLM_API_BASE=https://api.example.invalid/v1
LLM_API_KEY=sk-replace-me-with-your-own-key
LLM_MODEL=example-model-name
LLM_TIMEOUT_SECONDS=30
# 失败后的重试次数（总尝试次数 = 1 + LLM_MAX_RETRIES）
LLM_MAX_RETRIES=2
# 低于该置信度的结论一律转人工
LLM_CONFIDENCE_THRESHOLD=0.85
LLM_TEMPERATURE=0
# 是否要求服务商返回 JSON 对象；不支持的服务商可设为 0
LLM_JSON_MODE=1

# ---------- 演示保护 ----------
# 本项目为公开演示，禁止接入真实银行/ERP 或执行真实资金操作
DEMO_MODE=true
